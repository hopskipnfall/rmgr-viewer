{
  "name": "@rmg-k/rmgr-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time visual playback of .rmgr replay files",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "generate:demo-summaries": "tsx scripts/generateDemoSummaries.ts"
  },
  "dependencies": {
    "@rmg-k/rmgr": "file:../rmgr-ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/hopskipnfall/rmgr-viewer.git"
  }
}
